<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Raw Monolog writer for var/log/stacknuts_viewgento.log - always wrapped by the real
         Logger\Logger class below, which is what actually gates on the admin-configured
         Log Level before anything reaches this writer. -->
    <virtualType name="StackNuts\ViewGento\Logger\Writer" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">stacknuts_viewgento</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">StackNuts\ViewGento\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="StackNuts\ViewGento\Logger\Logger">
        <arguments>
            <argument name="writer" xsi:type="object">StackNuts\ViewGento\Logger\Writer</argument>
        </arguments>
    </type>

    <!-- Every class below takes Psr\Log\LoggerInterface in its constructor but must get
         THIS module's own gated logger, not Magento's shared system.log - a global
         preference for Psr\Log\LoggerInterface would hijack logging for the entire
         application, so each consumer is wired individually instead, the same pattern
         StackNuts_CloudflareCache uses. -->
    <!-- Built-in reporters. Third-party modules extend this same "reporters" array from
         their own di.xml - see Api\ReporterInterface for the contract and README for a
         worked example. -->
    <type name="StackNuts\ViewGento\Model\ReporterPool">
        <arguments>
            <argument name="logger" xsi:type="object">StackNuts\ViewGento\Logger\Logger</argument>
            <argument name="reporters" xsi:type="array">
                <item name="core" xsi:type="object">StackNuts\ViewGento\Model\Reporter\CoreReporter</item>
                <item name="modules" xsi:type="object">StackNuts\ViewGento\Model\Reporter\ModuleReporter</item>
                <item name="composer" xsi:type="object">StackNuts\ViewGento\Model\Reporter\ComposerReporter</item>
                <item name="db_schema" xsi:type="object">StackNuts\ViewGento\Model\Reporter\DbSchemaReporter</item>
                <item name="patches" xsi:type="object">StackNuts\ViewGento\Model\Reporter\PatchReporter</item>
                <item name="indexers" xsi:type="object">StackNuts\ViewGento\Model\Reporter\IndexerReporter</item>
                <item name="cron" xsi:type="object">StackNuts\ViewGento\Model\Reporter\CronReporter</item>
                <item name="cache" xsi:type="object">StackNuts\ViewGento\Model\Reporter\CacheReporter</item>
                <item name="security" xsi:type="object">StackNuts\ViewGento\Model\Reporter\SecurityReporter</item>
                <item name="redis" xsi:type="object">StackNuts\ViewGento\Model\Reporter\RedisReporter</item>
                <item name="search" xsi:type="object">StackNuts\ViewGento\Model\Reporter\SearchReporter</item>
                <item name="rabbitmq" xsi:type="object">StackNuts\ViewGento\Model\Reporter\RabbitMqReporter</item>
                <item name="disk" xsi:type="object">StackNuts\ViewGento\Model\Reporter\DiskSpaceReporter</item>
                <item name="database" xsi:type="object">StackNuts\ViewGento\Model\Reporter\DatabaseReporter</item>
            </argument>
        </arguments>
    </type>
    <type name="StackNuts\ViewGento\Model\Transport">
        <arguments>
            <argument name="logger" xsi:type="object">StackNuts\ViewGento\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="StackNuts\ViewGento\Model\ReportSender">
        <arguments>
            <argument name="logger" xsi:type="object">StackNuts\ViewGento\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="StackNuts\ViewGento\Model\Reporter\PatchReporter">
        <arguments>
            <argument name="logger" xsi:type="object">StackNuts\ViewGento\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="StackNuts\ViewGento\Cron\SendReport">
        <arguments>
            <argument name="logger" xsi:type="object">StackNuts\ViewGento\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="StackNuts\ViewGento\Cron\SendHeartbeat">
        <arguments>
            <argument name="logger" xsi:type="object">StackNuts\ViewGento\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="StackNuts\ViewGento\Plugin\App\MaintenanceModePlugin">
        <arguments>
            <argument name="logger" xsi:type="object">StackNuts\ViewGento\Logger\Logger</argument>
        </arguments>
    </type>

    <!-- Instant heartbeat on maintenance-mode change (see Plugin\App\MaintenanceModePlugin). -->
    <type name="Magento\Framework\App\MaintenanceMode">
        <plugin name="stacknuts_viewgento_maintenance_mode_heartbeat" type="StackNuts\ViewGento\Plugin\App\MaintenanceModePlugin" />
    </type>

    <!-- CLI commands -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="stacknuts_viewgento_send" xsi:type="object">StackNuts\ViewGento\Console\Command\SendReportCommand</item>
            </argument>
        </arguments>
    </type>
</config>
